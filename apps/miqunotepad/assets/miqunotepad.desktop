[Desktop Entry]
Type=Application
Name=MiquNotepad
GenericName=Text Editor
Comment=Lightweight and elegant native text editor built with miqutoolkit
Exec=miqunotepad %U
Icon=miqunotepad
Terminal=false
Categories=Utility;TextEditor;Development;
MimeType=text/plain;text/x-chdr;text/x-csrc;text/x-c++hdr;text/x-c++src;text/x-markdown;text/x-python;text/x-shellscript;application/x-shellscript;application/json;application/xml;text/xml;text/yaml;application/x-yaml;text/x-toml;text/css;application/javascript;text/javascript;text/x-rust;text/x-go;text/x-cmake;text/x-makefile;text/csv;text/x-log;text/x-ini;
Keywords=text;editor;notes;notepad;code;miqu;
StartupNotify=true
StartupWMClass=miqunotepad
